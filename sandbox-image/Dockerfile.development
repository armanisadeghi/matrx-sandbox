ARG BASE_IMAGE=matrx-sandbox:slim
FROM ${BASE_IMAGE}

LABEL maintainer="AI Matrx <team@aimatrx.com>"
LABEL description="Internal AI Matrx development worker — persistent workspace, current repo toolchains"

USER root

# The normal slim image stays small for customer sandboxes.  This internal-only
# derivative adds exactly what the AI Matrx repositories and their canonical
# release scripts require ON TOP of the shared toolchain contract.
#
# Node 22, npm 11 with an agent-writable global prefix, the install-script
# policy, Python 3.12 and the `browse` CLI all come from :slim now — this layer
# must NOT reinstall them.  It used to install its own nodesource Node 22 while
# the base was still Node 20, which is exactly how a "development" box ended up
# reported as Node 20 in the field: whichever layer ran last won, and nothing
# checked.  The verification block below is the check.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git-lfs \
    && rm -rf /var/lib/apt/lists/* \
    && git lfs install --system \
    # Contract verification — a base-image regression fails THIS build, loudly,
    # instead of shipping an internal worker below the floor.
    && node --version \
    && node -e "process.exit(parseInt(process.versions.node) >= 22 ? 0 : 1)" \
    && python3 -c "import sys; v=sys.version_info; assert v[:2] >= (3, 12) and v.releaselevel == 'final', sys.version" \
    && npm --version \
    && pnpm --version \
    && uv --version \
    && gh --version \
    && test -x /usr/local/bin/browse

RUN echo "development" > /etc/sandbox-image-tag

ARG MATRX_IMAGE_VERSION=dev
ENV MATRX_IMAGE_VERSION=${MATRX_IMAGE_VERSION}
LABEL com.aimatrx.sandbox.version="${MATRX_IMAGE_VERSION}"
RUN echo "${MATRX_IMAGE_VERSION}" > /etc/sandbox-image-version

