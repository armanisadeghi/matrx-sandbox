# syntax=docker/dockerfile:1.7
#
# matrx-sandbox:aidream
#
# Extends matrx-sandbox:core with the full aidream-current monorepo baked
# into /opt/aidream-template. On first spawn of a sandbox using this image,
# entrypoint-aidream.sh copies the template into /home/agent/aidream — the
# per-user persistent volume — so the user can edit packages/, run tests,
# and have changes persist across sandbox lifecycles.
#
# Build args:
#   AIDREAM_GIT_SHA   — for traceability; printed in `mtx aidream version`.
#                       Default: "unknown" so local builds don't fail.
#
# Image size target: ~5–6 GB (vs 2.88 GB for :core). The bulk is uv-installed
# Python 3.13 deps from aidream's pyproject.toml — torch-free, but includes
# opencv-python-headless, pymupdf, playwright (deduped against :core's layer
# where possible), and the matrx-* workspace packages.

ARG CORE_VERSION=core
FROM matrx-sandbox:${CORE_VERSION} AS base

ARG AIDREAM_GIT_SHA=unknown
ENV AIDREAM_GIT_SHA=${AIDREAM_GIT_SHA}

# Zero-drift version stamp. Defaults to "dev" so local builds don't fail. The
# hosted/EC2 deploy passes the commit SHA so /etc/sandbox-image-version returned
# by GET /drift can tell old aidream layers apart from a fresh rebuild. See
# docs/ZERO_DRIFT.md.
ARG MATRX_IMAGE_VERSION=dev
ENV MATRX_IMAGE_VERSION=${MATRX_IMAGE_VERSION}
LABEL com.aimatrx.sandbox.version="${MATRX_IMAGE_VERSION}"

# Image-variant tag — overrides the "core" stamp from the base image so
# entrypoint-local.sh's SANDBOX_MODE picks the right value when this image
# layers on top of :local. Read by /home/agent/.sandbox_env on every boot.
USER root
RUN echo "aidream" > /etc/sandbox-image-tag \
    && echo "${MATRX_IMAGE_VERSION}" > /etc/sandbox-image-version

# ─── System deps for aidream (mirroring aidream/Dockerfile) ────────────────
# Skipping software-properties-common / deadsnakes PPA — it's brittle on
# Ubuntu 22.04 (broken python3-apt + dbus dependency cascades). Instead we
# let uv install its own Python 3.13 below.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    portaudio19-dev \
    libasound2-dev \
    libpulse-dev \
    ffmpeg \
    chromium-driver \
    libmagic1 \
    libpq-dev \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

# ─── uv installer + uv-managed Python 3.13 ─────────────────────────────────
# uv installs its own Python — avoids the deadsnakes-PPA + python3-apt
# breakage on Ubuntu 22.04. The :core image's system Python 3.11 stays
# untouched (matrx_agent daemon + mtx CLI still use it).
ENV UV_INSTALL_DIR=/usr/local/bin
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN curl -LsSf https://astral.sh/uv/0.5.18/install.sh | sh \
    && uv --version \
    && mkdir -p "${UV_PYTHON_INSTALL_DIR}" \
    && uv python install 3.13 \
    && uv python find 3.13

# ─── Bake aidream into /opt/aidream-template ───────────────────────────────
# This is the read-only source of truth on the image. The user's working
# copy lives at /home/agent/aidream and is created/refreshed by
# entrypoint-aidream.sh and `mtx aidream {update,reset}`.
ENV AIDREAM_TEMPLATE_DIR=/opt/aidream-template
RUN mkdir -p "$AIDREAM_TEMPLATE_DIR"

# Put the user's working venv on PATH for ALL processes — interactive,
# non-interactive, bash -c, the matrx_agent daemon's exec endpoint, ssh
# sessions, everything. The directory doesn't exist until entrypoint-aidream.sh
# seeds /home/agent/aidream from the template, but a non-existent PATH entry
# is harmless. Once seeded, `python -c "import matrx_ai"` just works.
ENV PATH="/home/agent/aidream/.venv/bin:${PATH}"

# Copy aidream source. .dockerignore-equivalent omissions (dashboard, studio,
# .git, knowledgebase, tmp, etc.) are listed in sandbox-image/.dockerignore.aidream
# which docker buildx can pick up via --file. We can't reference an alternate
# .dockerignore from this Dockerfile alone, so we copy then prune.
COPY --chown=agent:agent ./aidream-src/ ${AIDREAM_TEMPLATE_DIR}/

# Drop the things the sandbox doesn't need (Vite frontends, node_modules if any
# leaked through, OS junk). Saves ~3 MB but mostly improves clarity.
RUN cd "$AIDREAM_TEMPLATE_DIR" \
    && rm -rf dashboard workflow-studio knowledgebase tmp .DS_Store \
    .agent .arman .claude .cursor .treasure-maps \
    && find . -name "__pycache__" -type d -prune -exec rm -rf {} + \
    && find . -name "*.pyc" -delete \
    && find . -name ".DS_Store" -delete

# Pre-resolve a venv at /opt/aidream-template/.venv using uv. This is the
# expensive step (~3-6 GB of wheels). We do it ONCE at image build time so
# every spawned sandbox starts with `import matrx_ai` working in 0 ms — no
# per-spawn pip install.
WORKDIR ${AIDREAM_TEMPLATE_DIR}
# uv-managed Python — no /usr/bin/python3.13 here; uv resolves "3.13" to its
# own install at $UV_PYTHON_INSTALL_DIR/.../bin/python3.13.
ENV UV_PYTHON=3.13
ENV UV_PROJECT_ENVIRONMENT=${AIDREAM_TEMPLATE_DIR}/.venv
# Make uv's Python install discoverable by non-root users (agent). Without
# this, `uv run` works as root in the build but fails as agent at runtime.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN uv sync --frozen --no-dev \
    && du -sh .venv \
    && chown -R agent:agent "${AIDREAM_TEMPLATE_DIR}" \
    && chmod -R a+rX "${UV_PYTHON_INSTALL_DIR}"

# ─── Helper scripts: mtx aidream {update,reset,serve,version} ──────────────
# Lives at /opt/sandbox/scripts/aidream-helpers.sh — sourced by the mtx
# subcommand wrapper installed below.
COPY --chown=root:root ./scripts/aidream-helpers.sh /opt/sandbox/scripts/aidream-helpers.sh
RUN chmod +x /opt/sandbox/scripts/aidream-helpers.sh

# Wrap `mtx aidream <subcommand>` → /opt/sandbox/scripts/aidream-helpers.sh.
# The base mtx CLI dispatches `mtx aidream` to this script.
COPY --chown=root:root ./scripts/entrypoint-aidream.sh /opt/sandbox/scripts/entrypoint-aidream.sh
RUN chmod +x /opt/sandbox/scripts/entrypoint-aidream.sh

# Bake the hosted-tier entrypoint variant (skips S3 hot-sync) so an aidream
# sandbox can run on the hosted tier without S3 creds. The :core image only
# ships the production entrypoint.sh which hard-fails when S3_BUCKET is unset.
# entrypoint-aidream.sh detects S3_BUCKET and dispatches accordingly.
# build-aidream.sh stages these from ../sandbox-local/scripts/ into ./scripts-local/
# at build time (Docker COPY can't reach outside the build context).
COPY --chown=root:root ./scripts-local/entrypoint-local.sh /opt/sandbox/scripts/entrypoint-local.sh
COPY --chown=root:root ./scripts-local/shutdown-local.sh   /opt/sandbox/scripts/shutdown-local.sh
RUN chmod +x /opt/sandbox/scripts/entrypoint-local.sh /opt/sandbox/scripts/shutdown-local.sh

# Activate-by-default for ALL shell types — interactive, non-interactive,
# login, and `bash -c "..."`. Three layers because each shell variant reads
# different files:
#   - /etc/profile.d/aidream.sh    sourced by login shells (bash -l, ssh)
#   - /etc/bash.bashrc append      sourced by non-login interactive shells
#   - /home/agent/.bashrc          user-level interactive
# For pure non-interactive (`bash -c "..."`) we also drop a symlink at
# /usr/local/bin/aidream-python so callers don't have to know the venv path.
RUN printf '%s\n' '#!/bin/sh' \
    '# Activate the aidream venv if present. Harmless if the user never' \
    '# spawned an aidream-variant sandbox (the dir simply does not exist).' \
    'if [ -d /home/agent/aidream/.venv/bin ]; then' \
    '    PATH="/home/agent/aidream/.venv/bin:$PATH"' \
    '    export PATH' \
    'fi' \
    > /etc/profile.d/aidream.sh \
    && chmod 0644 /etc/profile.d/aidream.sh \
    && echo '. /etc/profile.d/aidream.sh' >> /etc/bash.bashrc \
    && echo '. /etc/profile.d/aidream.sh' >> /home/agent/.bashrc \
    && chown agent:agent /home/agent/.bashrc \
    && ln -sf /home/agent/aidream/.venv/bin/python /usr/local/bin/aidream-python

# ─── Replace entrypoint with the aidream-aware variant ─────────────────────
# Wraps the existing entrypoint with a "first-spawn copy template → home" step.
# Daemon + ttyd + cloud-files-sync + persistence module all still run.
ENTRYPOINT ["tini", "--"]
CMD ["/opt/sandbox/scripts/entrypoint-aidream.sh"]

USER agent
WORKDIR /home/agent
