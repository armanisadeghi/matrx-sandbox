# Selective .dockerignore for the matrx-sandbox:aidream build.
# Use with: docker build -f Dockerfile.aidream --build-context aidream-src=/path/to/aidream
# The build script (build-aidream.sh) handles this — most callers don't need
# to edit this file.

**/.git
**/.git/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.pyd
**/.DS_Store
**/.cursor
**/.cursor/**
**/.claude
**/.claude/**
**/.agent
**/.agent/**
**/.arman
**/.arman/**
**/.treasure-maps
**/.treasure-maps/**
**/dashboard/node_modules
**/workflow-studio/node_modules
**/node_modules
**/.venv
**/.next
**/dist
**/build
**/tmp
