#!/usr/bin/env bash
# Git credential helper for sandbox-injected GitHub tokens.
#
# Git invokes helpers as: helper <get|store|erase>, passing credential fields on
# stdin. For "get" against github.com, return credentials from the process env.
# The token never lands in ~/.gitconfig or any persistent helper file.

set -euo pipefail

operation="${1:-get}"
if [ "$operation" != "get" ]; then
    exit 0
fi

protocol=""
host=""
while IFS='=' read -r key value; do
    [ -n "$key" ] || break
    case "$key" in
        protocol) protocol="$value" ;;
        host) host="$value" ;;
    esac
done

case "${protocol}:${host}" in
    https:github.com|https:www.github.com) ;;
    *) exit 0 ;;
esac

token="${GITHUB_TOKEN:-${GH_TOKEN:-${GITHUB_PAT:-${MATRX_GITHUB_TOKEN:-}}}}"
[ -n "$token" ] || exit 0

username="${GITHUB_USERNAME:-${GITHUB_USER:-x-access-token}}"
printf 'username=%s\n' "$username"
printf 'password=%s\n' "$token"
