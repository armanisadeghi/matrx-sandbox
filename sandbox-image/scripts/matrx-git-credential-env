#!/usr/bin/env bash
# Git credential helper for the user's AI Matrx GitHub connection.
#
# Git invokes helpers as: helper <get|store|erase>, passing credential fields on
# stdin. For "get" against github.com, request the user's current short-lived
# GitHub App token through the sandbox's existing trusted AI Dream bridge.
# Explicit env tokens remain a fallback for local/legacy boxes. The token never
# lands in ~/.gitconfig or any persistent helper file.
#
# The bridge call carries BOTH halves of the request context — actor and
# organization — built by the one shell helper (bridge-headers.sh). A box whose
# environment is missing either says so on stderr and skips the bridge; it never
# calls AI Dream with half the context (AI Dream refuses that with HTTP 400).
#
# WHERE THE IDENTITY COMES FROM UNDER SSH, AND THE RULING ON THE TOKEN
# --------------------------------------------------------------------
# sshd passes the container environment to nothing it starts, so under
# `ssh box 'git push'` this helper used to see no URL, no token, no USER_ID and
# no ORGANIZATION_ID. bridge-headers.sh then took its QUIET "unwired image"
# branch on a box that was fully wired, this helper fell through to an absent
# GITHUB_TOKEN and exited 0, and git reported a plain auth failure: the user's
# connected GitHub account was silently not there. Since 2026-09-17
# bridge-headers.sh loads /etc/matrx/bridge-env.sh — the identity every
# entrypoint publishes out of the container env — so the helper sees exactly
# what the API daemon sees, in every shell type.
#
# RULING: the shell MAY hold MATRX_AIDREAM_SERVICE_TOKEN. Inside this container
# there is nothing to protect it from: SSH admits only `agent` and `root`,
# `agent` has passwordless sudo, and the API daemon runs as `agent` with the
# token in its environment — so `tr '\0' '\n' < /proc/<daemon>/environ` (or
# `sudo … /proc/1/environ`) already hands any shell the same value. Routing
# this helper through a localhost daemon endpoint instead would be a boundary
# that does not exist: it would need the daemon's own secret, which the shell
# equally does not have, on a daemon that binds 0.0.0.0 and FAILS OPEN when
# MATRX_AGENT_TOKEN is unset — strictly weaker. The real defect is that the
# token is ONE shared master (any box can act as any user); the remedy is the
# per-sandbox scoped token tracked at the bottom of
# docs/incidents/2026-09-13-platform-env-leak.md, after which this helper
# carries the scoped token unchanged. Full reasoning and the verification:
# scripts/write-bridge-env.sh.

set -euo pipefail

operation="${1:-get}"
if [ "$operation" != "get" ]; then
    exit 0
fi

protocol=""
host=""
while IFS='=' read -r key value; do
    [ -n "$key" ] || break
    case "$key" in
        protocol) protocol="$value" ;;
        host) host="$value" ;;
    esac
done

case "${protocol}:${host}" in
    https:github.com|https:www.github.com) ;;
    *) exit 0 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bridge-headers.sh
. "$SCRIPT_DIR/bridge-headers.sh"

# Read one field out of a JSON refusal body, or nothing. The SERVER's words
# are what a person needs — "Connect a GitHub account" is the wrong remedy for
# "you are not a member of that organization".
matrx_json_field() {
    python3 -c '
import json, sys
try:
    body = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)
detail = body.get("detail") if isinstance(body, dict) else None
for source in (detail, body):
    if isinstance(source, dict):
        value = source.get(sys.argv[1])
        if isinstance(value, str) and value.strip():
            print(value.strip())
            sys.exit(0)
if sys.argv[1] == "message" and isinstance(detail, str) and detail.strip():
    print(detail.strip())
' "$1" 2>/dev/null || true
}

token=""
bridge_status=""
bridge_body=""
if matrx_bridge_ready "git-credentials"; then
    # -f is deliberately NOT used and the body is NOT discarded: curl -f hides
    # the status AND the body, so a 403 organization_membership_required or a
    # 503 membership_unverifiable used to land in the "no GitHub account
    # connected" branch — the wrong remedy, for a person who cannot act on it.
    bridge_body_file="$(mktemp)"
    bridge_status="$(
        curl -sS --max-time 15 \
            -o "$bridge_body_file" -w '%{http_code}' \
            "${MATRX_BRIDGE_HEADERS[@]}" \
            -H "Accept: text/plain" \
            "${MATRX_AIDREAM_URL%/}/api/github-integrations/internal/access-token" \
            2>/dev/null || true
    )"
    bridge_body="$(cat "$bridge_body_file" 2>/dev/null || true)"
    rm -f "$bridge_body_file"
    case "$bridge_status" in
        2*) token="$bridge_body" ;;
    esac
fi

if [ -z "$token" ]; then
    token="${GITHUB_TOKEN:-${GH_TOKEN:-${GITHUB_PAT:-${MATRX_GITHUB_TOKEN:-}}}}"
fi

# Nothing fails silently: git only reports "authentication failed", so the one
# place that knows WHY says it here. Five distinct cases, five remedies — and
# when the SERVER refused, it is the server's own message and remedy that gets
# printed, never this script's guess at one.
if [ -z "$token" ]; then
    if matrx_bridge_has_no_identity; then
        echo "[git-credentials] This sandbox carries no AI Dream identity (no MATRX_AIDREAM_URL, MATRX_AIDREAM_SERVICE_TOKEN, USER_ID or ORGANIZATION_ID) and no GITHUB_TOKEN, so git has no credential for github.com. Recreate the sandbox from AI Matrx so it is wired to your account, or set GITHUB_TOKEN for a one-off push." >&2
    elif [ -n "$(matrx_bridge_missing_env)" ]; then
        # matrx_bridge_ready already named the missing variables on stderr.
        echo "[git-credentials] No GitHub token: the AI Dream bridge call above was refused, and no GITHUB_TOKEN is set in this shell." >&2
    elif [ "$bridge_status" = "000" ] || [ -z "$bridge_status" ] && [ -n "${MATRX_BRIDGE_HEADERS[*]:-}" ]; then
        echo "[git-credentials] Could not reach AI Dream (${MATRX_AIDREAM_URL%/}) to fetch your GitHub token, and no GITHUB_TOKEN is set. This is a network/server problem, not a missing GitHub connection — try again, or set GITHUB_TOKEN for a one-off push." >&2
    elif [ -n "$bridge_status" ] && [ "$bridge_status" != "404" ] && [ "${bridge_status#2}" = "$bridge_status" ]; then
        # The server refused, and the server knows why. Print ITS message and
        # ITS remedy — this is the branch that carries 403
        # organization_membership_required and 503 membership_unverifiable.
        server_message="$(printf '%s' "$bridge_body" | matrx_json_field message)"
        server_remedy="$(printf '%s' "$bridge_body" | matrx_json_field remedy)"
        server_code="$(printf '%s' "$bridge_body" | matrx_json_field code)"
        [ -n "$server_message" ] || server_message="$(printf '%s' "$bridge_body" | head -c 300)"
        echo "[git-credentials] AI Dream refused this sandbox's GitHub token request (HTTP ${bridge_status}${server_code:+ ${server_code}})${server_message:+: ${server_message}}" >&2
        if [ -n "$server_remedy" ]; then
            echo "[git-credentials] Remedy: ${server_remedy}" >&2
        fi
        echo "[git-credentials] No GITHUB_TOKEN is set in this shell either, so git has no credential for github.com." >&2
    else
        echo "[git-credentials] AI Dream (${MATRX_AIDREAM_URL%/}/api/github-integrations/internal/access-token) returned no GitHub token for this user, and no GITHUB_TOKEN is set. Connect a GitHub account in AI Matrx, or set GITHUB_TOKEN for a one-off push." >&2
    fi
    exit 0
fi

username="${GITHUB_USERNAME:-${GITHUB_USER:-x-access-token}}"
printf 'username=%s\n' "$username"
printf 'password=%s\n' "$token"
