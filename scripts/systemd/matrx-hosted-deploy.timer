[Unit]
Description=Run the Matrx hosted-tier pull deploy every 2 minutes

[Timer]
OnBootSec=2min
# Measured from when the last run FINISHED (not started), so a long image
# build never overlaps the next tick even without the script's flock.
OnUnitInactiveSec=2min
RandomizedDelaySec=15s

[Install]
WantedBy=timers.target
