# ─── Matrx Sandbox Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in the values.

# ─── AWS ──────────────────────────────────────────────────────────────────────
MATRX_S3_BUCKET=matrx-sandbox-storage-CHANGEME
MATRX_S3_REGION=us-east-1

# AWS credentials (only needed for local dev — EC2 uses IAM instance role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Runtime identity (MATRX_STAGE / MATRX_ROLE) ──────────────────────────────
# The two declared axes from aidream's runtime_env.py. Required on every host
# (a missing/unknown value fails LOUD at startup for runtime_env consumers).
#   MATRX_STAGE = which code line this is: production | development | local
#                 (test is auto-detected via PYTEST_CURRENT_TEST).
#   MATRX_ROLE  = what this process's job is: app_server | worker | sandbox |
#                 sandbox_host.
# A sandbox HOST (the box that provisions + serves sandbox containers) is
# role=sandbox_host. EC2 prod host -> production/sandbox_host; the hosted host
# on the /srv dev server -> development/sandbox_host.
# Spawned sandbox CONTAINERS need neither — they auto-detect stage=production
# + role=sandbox via the /opt/aidream-template marker baked into the image.
MATRX_STAGE=development
MATRX_ROLE=sandbox_host

# ─── Orchestrator ─────────────────────────────────────────────────────────────
MATRX_HOST=0.0.0.0
MATRX_PORT=8000
# Keep false in any shared/production deployment. Debug enables verbose logging
# and (when the dev compose command is used) uvicorn --reload. Local-only.
MATRX_DEBUG=false
# Which tier this orchestrator hosts: "ec2" or "hosted". Used to reject creates
# for the wrong tier and to scope reconcile/reaper to this orchestrator's boxes.
# MATRX_HOST_TIER=

# ─── API Authentication ─────────────────────────────────────────────────────────
# Service-to-service API key. If empty, API runs unauthenticated (local dev only).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MATRX_API_KEY=

# ─── Database (Sandbox Registry Persistence) ───────────────────────────────────
# Options: "memory" (default, no persistence) or "postgres"
MATRX_SANDBOX_STORE=memory
# Required if MATRX_SANDBOX_STORE=postgres. Standard Postgres connection string.
# MATRX_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Docker / Sandbox ────────────────────────────────────────────────────────
MATRX_SANDBOX_IMAGE=matrx-sandbox:latest
MATRX_CONTAINER_CPU_LIMIT=2.0
MATRX_CONTAINER_MEMORY_LIMIT=4g
MATRX_MAX_SESSION_DURATION_SECONDS=7200
MATRX_SHUTDOWN_TIMEOUT_SECONDS=30
MATRX_DOCKER_NETWORK=bridge
MATRX_CONTAINER_DISK_LIMIT=20g
MATRX_HEALTHCHECK_INTERVAL_SECONDS=30
MATRX_MAX_COMMAND_LENGTH=10000
MATRX_COMMAND_TIMEOUT_SECONDS=300
MATRX_LOG_LEVEL=INFO
# Log format: "json" (default, for production) or "text" (human-readable, for local dev)
MATRX_LOG_FORMAT=text

# ─── Warm pool (hosted tier) ────────────────────────────────────────────────
# Pre-boot N unclaimed boxes so "launch from chat" is a fast claim. 0 disables.
# MATRX_WARM_POOL_SIZE=0
# MATRX_WARM_POOL_TEMPLATE=slim
# Per-template counts, e.g. "slim:1,aidream:1" (takes precedence when set).
# MATRX_WARM_POOL_TEMPLATES=

# ─── Zero-drift auto-migration ──────────────────────────────────────────────
# MATRX_AUTO_MIGRATE=false
# MATRX_MIGRATE_MAX_PER_PASS=2

# ─── AI Dream integration ────────────────────────────────────────────────────
# Where AI Dream lives + the service token the orchestrator hands each sandbox.
# On the hosted tier these are auto-read from /srv/projects/aidream/.env; the
# EC2 tier MUST set them explicitly (see KNOWN_DEFECTS Bug 7).
# MATRX_AIDREAM_URL=
# MATRX_AIDREAM_SERVICE_TOKEN=

# ─── Browser-direct access (token issuance, proxy, CORS) ────────────────────
# HMAC secret for the short-lived sandbox-scoped access tokens. Required for the
# /access-tokens, /agent-binding, /proxy/* and WebSocket routes; if empty those
# return 503 and WebSocket auth cannot be satisfied by a scoped token.
# MATRX_ACCESS_TOKEN_SECRET=
# External base URL this orchestrator serves on (no trailing slash). Used to
# build proxy_url / direct_url / ws_base.
# MATRX_PUBLIC_URL=
# Internal/in-VPC base URL for server-to-server (co-located AI Dream) tool calls.
# Falls back to MATRX_PUBLIC_URL when unset; auto-detected on EC2.
# MATRX_INTERNAL_URL=
# Public hostname advertised by SSH access responses. Defaults to PUBLIC_URL host.
# MATRX_SSH_HOST=
# Comma-separated CORS allow-list for browser-direct calls (never "*").
# MATRX_CORS_ALLOWED_ORIGINS=
